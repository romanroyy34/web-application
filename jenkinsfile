pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/romanroyy34/web-application.git'
            }
        }

        stage('Build') {
            steps {
                echo 'Building Student Result Application'
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                mkdir -p /var/www/student-result
                cp -r * /var/www/student-result/
                '''
            }
        }
    }
}
